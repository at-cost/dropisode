{
  "name": "@reel/studio",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "The studio API and web UI, shared by apps/local and apps/hosted.",
  "exports": {
    ".": "./src/index.ts",
    "./web-dist": "./dist/web/index.html"
  },
  "scripts": {
    "dev": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@reel/core": "workspace:*",
    "@reel/money": "workspace:*",
    "hono": "^4.13.14",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.4"
  }
}
