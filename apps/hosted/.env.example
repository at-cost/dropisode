# Reel hosted. Copy to .env (never commit it). Values marked OWNER need the owner's accounts.
NODE_ENV=production
APP_URL=https://reel.example            # OWNER: domain not chosen yet
APP_SECRET=                             # 32+ random characters: openssl rand -base64 48
POSTGRES_PASSWORD=
MIGRATE_ON_BOOT=true
WORKER_MODE=inline

PROVIDER=fal
FAL_KEY=                                # OWNER: fal.ai key
FAL_BILLING_KEY=                        # OWNER: fal key with the BILLING preset (real per-request costs)

STORAGE_DRIVER=r2
R2_ACCOUNT_ID=                          # OWNER: Cloudflare account
R2_BUCKET=reel-media
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

SMTP_URL=                               # smtps://KEY:SECRET@email-smtp.<region>.amazonaws.com:465
EMAIL_FROM=Reel <no-reply@reel.example>
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

BILLING_ENABLED=false                   # OWNER: turn on with live Stripe keys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

OPENAI_API_KEY=                         # moderation (free); required in production
ADMIN_EMAILS=
FINANCES_PUBLIC=true
